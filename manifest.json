      "market": {
        "displayName": {
          "zh": "下载工作台",
          "en": "Download Workbench"
        },
        "summary": {
          "zh": "提交 Pixiv 抓取任务、管理下载队列与下载历史的工作台（必选）。",
          "en": "Workbench for submitting Pixiv fetch tasks and managing the download queue and history (required)."
        },
        "description": {
          "zh": "官方必需插件，提供基础插画下载工作流、下载队列、批量状态、Pixiv 代理入口、下载页静态资源、油猴脚本分发与计划下载宿主。缺失时核心壳进入恢复 / 补齐模式。",
          "en": "Official required plugin providing the basic illustration download workflow, queue, batch state, Pixiv proxy endpoints, workbench static assets, userscript distribution, and scheduled download host. When missing, the core shell enters recovery/repair mode."
        },
        "author": "Sywyar",
        "sourceType": "official",
